{
    "swagger": "2.0",
    "info": {
        "description": "REST API for restaurant table reservations with smart table assignment.",
        "title": "Restaurant Table Reservation API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/reservations": {
            "post": {
                "description": "Create a reservation. Omit table_id for smart table assignment.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reservations"
                ],
                "summary": "Book a table",
                "parameters": [
                    {
                        "description": "Reservation details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.BookReservationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.ReservationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    }
                }
            }
        },
        "/reservations/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reservations"
                ],
                "summary": "View a reservation",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Reservation ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ReservationResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    }
                }
            },
            "delete": {
                "description": "Cancellation must occur before the configured lead time",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reservations"
                ],
                "summary": "Cancel a reservation",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Reservation ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.CancelReservationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    }
                }
            }
        },
        "/slots": {
            "get": {
                "description": "Shows available time slots and tables for a date",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reservations"
                ],
                "summary": "View available slots",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Date (YYYY-MM-DD)",
                        "name": "date",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.AvailableSlotsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    }
                }
            }
        },
        "/tables": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "List all tables",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.TableResponse"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Restaurant staff adds a new table",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "Create a table",
                "parameters": [
                    {
                        "description": "Table details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateTableRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.TableResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/apperror.AppError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "apperror.AppError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "domain.Location": {
            "type": "string",
            "enum": [
                "indoor",
                "outdoor"
            ],
            "x-enum-varnames": [
                "LocationIndoor",
                "LocationOutdoor"
            ]
        },
        "domain.ReservationStatus": {
            "type": "string",
            "enum": [
                "confirmed",
                "cancelled"
            ],
            "x-enum-varnames": [
                "ReservationStatusConfirmed",
                "ReservationStatusCancelled"
            ]
        },
        "dto.AvailableSlotResponse": {
            "type": "object",
            "properties": {
                "available_tables": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.TableResponse"
                    }
                },
                "time_slot": {
                    "type": "string"
                }
            }
        },
        "dto.AvailableSlotsResponse": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string"
                },
                "slots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.AvailableSlotResponse"
                    }
                }
            }
        },
        "dto.BookReservationRequest": {
            "type": "object",
            "required": [
                "customer_email",
                "customer_name",
                "customer_phone",
                "guest_count",
                "reservation_date",
                "time_slot"
            ],
            "properties": {
                "customer_email": {
                    "type": "string"
                },
                "customer_name": {
                    "type": "string"
                },
                "customer_phone": {
                    "type": "string"
                },
                "guest_count": {
                    "type": "integer",
                    "minimum": 1
                },
                "reservation_date": {
                    "type": "string"
                },
                "special_requests": {
                    "type": "string"
                },
                "table_id": {
                    "type": "integer"
                },
                "time_slot": {
                    "type": "string"
                }
            }
        },
        "dto.CancelReservationResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "status": {
                    "$ref": "#/definitions/domain.ReservationStatus"
                }
            }
        },
        "dto.CreateTableRequest": {
            "type": "object",
            "required": [
                "capacity",
                "location",
                "table_number"
            ],
            "properties": {
                "capacity": {
                    "type": "integer",
                    "minimum": 1
                },
                "location": {
                    "$ref": "#/definitions/domain.Location"
                },
                "table_number": {
                    "type": "string"
                }
            }
        },
        "dto.ReservationResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "customer_email": {
                    "type": "string"
                },
                "customer_name": {
                    "type": "string"
                },
                "customer_phone": {
                    "type": "string"
                },
                "guest_count": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "reservation_date": {
                    "type": "string"
                },
                "special_requests": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/domain.ReservationStatus"
                },
                "table": {
                    "$ref": "#/definitions/dto.TableResponse"
                },
                "time_slot": {
                    "type": "string"
                }
            }
        },
        "dto.TableResponse": {
            "type": "object",
            "properties": {
                "capacity": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "location": {
                    "$ref": "#/definitions/domain.Location"
                },
                "table_number": {
                    "type": "string"
                }
            }
        }
    }
}